        <mxCell id="f1-ley-ct" value="&lt;b&gt;Objeto control&lt;/b&gt; · una acción o decisión de July; debajo, el método de CLS-01 que la implementa" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="2136.0" y="198" width="336" height="42" as="geometry" /></mxCell>
        <mxCell id="f1-ley-e" value="" style="ellipse;shape=umlEntity;html=1;fillColor=#DAE8FC;strokeColor=#2E5AA8;" vertex="1" parent="1"><mxGeometry x="2084.0" y="252" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="f1-ley-et" value="&lt;b&gt;Objeto entidad&lt;/b&gt; · información que July guarda (entidad de negocio de CLS-01)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="2136.0" y="250" width="336" height="42" as="geometry" /></mxCell>
        <mxCell id="f1-ley-k" value="" style="ellipse;shape=umlEntity;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="2084.0" y="304" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="f1-ley-kt" value="&lt;b&gt;Objeto entidad de configuración&lt;/b&gt; · la publica un área de la cooperativa; July solo la lee" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="2136.0" y="302" width="336" height="42" as="geometry" /></mxCell>
        <mxCell id="f1-ley-lineas" value="——&amp;gt; flujo principal · &lt;b&gt;1.2.2: 3&lt;/b&gt; = caso 1.2.2, paso 3 de CU-08&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;- - -&amp;gt; flujo alternativo (A1, A2…)&lt;/font&gt;&lt;br&gt;——— control ↔ entidad, con lo que hace sobre ella&lt;br&gt;Marco punteado: controles propios de un caso de nivel 2. Los objetos fuera de los marcos los comparten varios casos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Conexiones permitidas:&lt;/b&gt; actor ↔ borde · borde ↔ control · control ↔ control · control ↔ entidad." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="2078.0" y="360" width="396" height="145" as="geometry" /></mxCell>
        <mxCell id="f1-traza" value="&lt;b&gt;Trazabilidad con CU-08&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 1.1.1 · Recibir la consulta por WhatsApp o web&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Prospecto → Canal WhatsApp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Canal → Verificar → Convertir → Abrir conversación&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Etiquetar origen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Reportar origen → Bandeja de marketing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;1a–3a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Prospecto ↔ Widget web (abre la sesión y escribe)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;4a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Widget web → … → Abrir conversación&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;3b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Etiquetar origen («origen directo»)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;4b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Reportar origen → Bandeja de marketing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 1.1.2 · Unificar los mensajes entrantes&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1–2&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Prospecto → Canal WhatsApp → Verificar autenticidad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;3–4&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Verificar autenticidad (firma, acuse)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Canal WhatsApp → Verificar autenticidad (contenido)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Convertir a formato común&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;1a–3a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Widget web → Verificar autenticidad (token)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;4b–5b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Verificar autenticidad → Canal (error de firma)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;7c–8c&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Atender mensaje (cola) → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 1.2.1 · Recibir atención inmediata&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;2–3&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Obtener guion vigente&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Componer saludo y aviso → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;5–6&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Registrar consentimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Obtener guion vigente (MENU) → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Prospecto elige una opción&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;5a–6a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Registrar consentimiento (rechazado)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;7a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Obtener guion vigente (MENU_BASICO) → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;8b–9b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Atender mensaje → Derivar → Bandeja del asesor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;10b–11b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Bandeja del asesor → Traspasar conversación&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;12b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Bandeja del asesor → Responder (emisor ASESOR)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 1.2.2 · Identificar al prospecto y su necesidad&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1–2&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Identificar intención&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Identificar intención → Responder (confirmar línea)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;4–6&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Consultar condición de socio ↔ Sistema core&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Registrar lead&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Registrar lead → Responder (número de seguimiento)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;3a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Identificar intención → Responder (opciones)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;3b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Responder pregunta frecuente → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;6c–7c&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Sistema core (error) → Registrar lead (POR_VERIFICAR)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;5d&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Atender mensaje → Registrar lead (POR_VERIFICAR)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="2064.0" y="540" width="420" height="676" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
