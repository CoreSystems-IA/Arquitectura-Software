        <mxCell id="f3-titulo" value="&lt;b&gt;Diagrama de robustez · Flujo de valor 3 · Entrega, seguimiento y conversión&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2996.4" height="36" as="geometry" /></mxCell>
        <mxCell id="f3-subtitulo" value="ROB-01 · Etapa 3 · Deriva de CU-08 (pasos) y CLS-01 (clases y métodos) · Reúne los casos de nivel 2 del diagrama CU-05: CU 3.1.1, CU 3.1.2, CU 3.2.1 y CU 3.2.2" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="2996.4" height="22" as="geometry" /></mxCell>
        <mxCell id="f3-ficha" value="&lt;b&gt;Actor principal:&lt;/b&gt; Asesor comercial (en 3.1.1 y 3.1.2 es el beneficiario: recibe la ficha y el lead en el CRM)&lt;br&gt;&lt;b&gt;Actores secundarios:&lt;/b&gt; Jefe comercial, CRM de la cooperativa, Prospecto, Personal de agencia, Comité de crédito; WhatsApp Business API (borde Chat del prospecto); el Jefe comercial publica los criterios de prioridad y las reglas de enrutamiento que July lee&lt;br&gt;&lt;b&gt;Recorrido:&lt;/b&gt; al terminar la precalificación July arma y prioriza la ficha (3.1.1) y registra el lead en el CRM (3.1.2); lo asigna a un asesor, que toma la conversación (3.2.1), y lo acompaña con recordatorios, la cita, los documentos y la resolución del comité hasta cerrarlo (3.2.2)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="2956.4" height="72" as="geometry" /></mxCell>
        <mxCell id="f3-ley" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="3056.4" y="110" width="420" height="400" as="geometry" /></mxCell>
        <mxCell id="f3-ley-t" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="3068.4" y="118" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="f3-ley-b" value="" style="shape=umlBoundary;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="3072.4" y="150" width="44" height="34" as="geometry" /></mxCell>
        <mxCell id="f3-ley-bt" value="&lt;b&gt;Objeto borde&lt;/b&gt; · por donde entra o sale algo de July (canal, bandeja de un colaborador, sistema externo)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="3128.4" y="146" width="336" height="42" as="geometry" /></mxCell>
        <mxCell id="f3-ley-c" value="" style="ellipse;shape=umlControl;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="3078.4" y="200" width="32" height="36" as="geometry" /></mxCell>
        <mxCell id="f3-ley-ct" value="&lt;b&gt;Objeto control&lt;/b&gt; · una acción o decisión de July; debajo, el método de CLS-01 que la implementa" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="3128.4" y="198" width="336" height="42" as="geometry" /></mxCell>
        <mxCell id="f3-ley-e" value="" style="ellipse;shape=umlEntity;html=1;fillColor=#DAE8FC;strokeColor=#2E5AA8;" vertex="1" parent="1"><mxGeometry x="3076.4" y="252" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="f3-ley-et" value="&lt;b&gt;Objeto entidad&lt;/b&gt; · información que July guarda (entidad de negocio de CLS-01)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="3128.4" y="250" width="336" height="42" as="geometry" /></mxCell>
        <mxCell id="f3-ley-k" value="" style="ellipse;shape=umlEntity;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="3076.4" y="304" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="f3-ley-kt" value="&lt;b&gt;Objeto entidad de configuración&lt;/b&gt; · la publica un área de la cooperativa; July solo la lee" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="3128.4" y="302" width="336" height="42" as="geometry" /></mxCell>
        <mxCell id="f3-ley-lineas" value="——&amp;gt; flujo principal · &lt;b&gt;1.2.2: 3&lt;/b&gt; = caso 1.2.2, paso 3 de CU-08&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;- - -&amp;gt; flujo alternativo (A1, A2…)&lt;/font&gt;&lt;br&gt;——— control ↔ entidad, con lo que hace sobre ella&lt;br&gt;Marco punteado: controles propios de un caso de nivel 2. Los objetos fuera de los marcos los comparten varios casos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Conexiones permitidas:&lt;/b&gt; actor ↔ borde · borde ↔ control · control ↔ control · control ↔ entidad." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="3070.4" y="360" width="396" height="145" as="geometry" /></mxCell>
        <mxCell id="f3-traza" value="&lt;b&gt;Trazabilidad con CU-08&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 3.1.1 · Generar la ficha del prospecto&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1–2&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Obtener criterios de prioridad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Priorizar lead → Consolidar ficha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Adjuntar historial → Bandeja del asesor (ficha)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;3a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Consolidar ficha (datos faltantes marcados)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 3.1.2 · Registrar el lead en el CRM&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1–2&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Buscar lead en el CRM ↔ CRM&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;3–4&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Sincronizar con el CRM ↔ CRM (crea)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Vincular id del CRM&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;2a–3a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Buscar (existe) → Sincronizar (actualiza)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;4b–6b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Sincronizar con el CRM (error, registra y reintenta)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;6c–7c&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Sincronizar (pendiente) → Notificar → Bandeja del jefe comercial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 3.2.1 · Recibir el lead asignado&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Bandeja del asesor → Marcar disponibilidad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;2–3&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Obtener reglas de enrutamiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Asignar lead&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Asignar lead → Notificar → Bandeja del asesor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Bandeja del asesor → Aceptar asignación&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Traspasar conversación → Bandeja del asesor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Avisar cambio de asesor → Chat&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;9&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Chat → Registrar mensaje → Bandeja del asesor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;6a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Plazo de atención vencido&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;7a–8a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Asignar lead (reasigna) → Notificar → Bandeja del jefe comercial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 3.2.2 · Hacer seguimiento y cerrar el lead&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Bandeja del asesor → Programar recordatorio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;2–3&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Enviar plantilla → Chat → Prospecto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Chat → Actualizar estado de la cita (CONFIRMADA)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Notificar → Bandeja de la agencia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Bandeja de la agencia → Actualizar estado (ATENDIDA)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Notificar → Bandeja del asesor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Bandeja del asesor → Registrar documentos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;9–10&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Enviar a resolución ↔ Bandeja del comité&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;11&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Notificar → Bandeja del asesor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;12&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Bandeja del asesor → Cerrar lead&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;13&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Cerrar lead → Sincronizar con el CRM → CRM&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;4a–5a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Sin respuesta → Reactivar → Enviar plantilla&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;5b–6b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Reactivar o enfriar lead (FRIO) → Notificar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;4c&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Chat → Reprogramar cita&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;5c–7c&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Reprogramar cita ↔ Bandeja de la agencia (REPROGRAMADA)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;8c&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Reprogramar cita → Chat&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="3056.4" y="540" width="420" height="676" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
