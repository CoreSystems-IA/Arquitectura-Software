        <mxCell id="f1-titulo" value="&lt;b&gt;Diagrama de robustez · Flujo de valor 1 · Atracción y primer contacto&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2004.0" height="36" as="geometry" /></mxCell>
        <mxCell id="f1-subtitulo" value="ROB-01 · Etapa 3 · Deriva de CU-08 (pasos) y CLS-01 (clases y métodos) · Reúne los casos de nivel 2 del diagrama CU-03: CU 1.1.1, CU 1.1.2, CU 1.2.1 y CU 1.2.2" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="2004.0" height="22" as="geometry" /></mxCell>
        <mxCell id="f1-ficha" value="&lt;b&gt;Actor principal:&lt;/b&gt; Prospecto&lt;br&gt;&lt;b&gt;Actores secundarios:&lt;/b&gt; WhatsApp Business API y Widget web (bordes de canal), Equipo de marketing, Asesor comercial, Sistema core; el Administrador del asistente y el Área de productos y crédito publican la configuración que July lee&lt;br&gt;&lt;b&gt;Recorrido:&lt;/b&gt; el mensaje entra por un canal, se verifica y se unifica (1.1.2); la primera consulta abre la conversación y etiqueta su origen (1.1.1); July saluda, pide el consentimiento y muestra el menú (1.2.1) y luego identifica la necesidad y registra el lead (1.2.2)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1964.0" height="72" as="geometry" /></mxCell>
