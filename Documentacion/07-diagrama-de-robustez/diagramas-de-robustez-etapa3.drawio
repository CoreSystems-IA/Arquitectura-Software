        <mxCell id="f1-ley-bt" value="&lt;b&gt;Objeto borde&lt;/b&gt; · por donde entra o sale algo de July (canal, bandeja de un colaborador, sistema externo)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="2136.0" y="146" width="336" height="42" as="geometry" /></mxCell>
