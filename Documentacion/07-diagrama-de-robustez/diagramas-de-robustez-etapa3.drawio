        <mxCell id="f2-elinea" value="&lt;b&gt;LineaCredito&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;tasa · plazos · montos · requisitos&lt;br&gt;publica: Área de productos y crédito&lt;/font&gt;" style="ellipse;shape=umlEntity;fillColor=#E1D5E7;strokeColor=#9673A6;labelBackgroundColor=#FFFFFF;labelWidth=200;verticalLabelPosition=bottom;verticalAlign=top;html=1;whiteSpace=wrap;fontSize=12;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="1490" y="1320" width="80" height="80" as="geometry" /></mxCell>
        <mxCell id="f2-ecita" value="&lt;b&gt;Cita&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;agencia · fechaHora · estado&lt;br&gt;agenda publicada por la agencia&lt;/font&gt;" style="ellipse;shape=umlEntity;fillColor=#DAE8FC;strokeColor=#2E5AA8;labelBackgroundColor=#FFFFFF;labelWidth=200;verticalLabelPosition=bottom;verticalAlign=top;html=1;whiteSpace=wrap;fontSize=12;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="1690" y="1320" width="80" height="80" as="geometry" /></mxCell>
        <mxCell id="f2-titulo" value="&lt;b&gt;Diagrama de robustez · Flujo de valor 2 · Captura, simulación y precalificación&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2996.4" height="36" as="geometry" /></mxCell>
        <mxCell id="f2-subtitulo" value="ROB-01 · Etapa 3 · Deriva de CU-08 (pasos) y CLS-01 (clases y métodos) · Reúne los casos de nivel 2 del diagrama CU-04: CU 2.1.1, CU 2.1.2, CU 2.2.1, CU 2.2.2, CU 2.3.1 y CU 2.3.2" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="2996.4" height="22" as="geometry" /></mxCell>
        <mxCell id="f2-ficha" value="&lt;b&gt;Actor principal:&lt;/b&gt; Prospecto&lt;br&gt;&lt;b&gt;Actores secundarios:&lt;/b&gt; Sistema core, Comité de crédito, Personal de agencia; WhatsApp Business API (borde Chat del prospecto); el Área de productos y crédito, el Comité de crédito y el Administrador del asistente publican la configuración que July lee&lt;br&gt;&lt;b&gt;Recorrido:&lt;/b&gt; July reúne y valida los datos de la solicitud (2.1.1, 2.1.2), muestra las líneas y sus condiciones (2.2.2), simula el crédito (2.2.1), precalifica con las reglas del comité (2.3.1) y orienta al prospecto hasta la cita en agencia (2.3.2)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="2956.4" height="72" as="geometry" /></mxCell>
        <mxCell id="f2-ley" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="3056.4" y="110" width="420" height="400" as="geometry" /></mxCell>
        <mxCell id="f2-ley-t" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="3068.4" y="118" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="f2-ley-b" value="" style="shape=umlBoundary;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="3072.4" y="150" width="44" height="34" as="geometry" /></mxCell>
        <mxCell id="f2-ley-bt" value="&lt;b&gt;Objeto borde&lt;/b&gt; · por donde entra o sale algo de July (canal, bandeja de un colaborador, sistema externo)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="3128.4" y="146" width="336" height="42" as="geometry" /></mxCell>
        <mxCell id="f2-ley-c" value="" style="ellipse;shape=umlControl;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="3078.4" y="200" width="32" height="36" as="geometry" /></mxCell>
        <mxCell id="f2-ley-ct" value="&lt;b&gt;Objeto control&lt;/b&gt; · una acción o decisión de July; debajo, el método de CLS-01 que la implementa" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="3128.4" y="198" width="336" height="42" as="geometry" /></mxCell>
        <mxCell id="f2-ley-e" value="" style="ellipse;shape=umlEntity;html=1;fillColor=#DAE8FC;strokeColor=#2E5AA8;" vertex="1" parent="1"><mxGeometry x="3076.4" y="252" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="f2-ley-et" value="&lt;b&gt;Objeto entidad&lt;/b&gt; · información que July guarda (entidad de negocio de CLS-01)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="3128.4" y="250" width="336" height="42" as="geometry" /></mxCell>
        <mxCell id="f2-ley-k" value="" style="ellipse;shape=umlEntity;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="3076.4" y="304" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="f2-ley-kt" value="&lt;b&gt;Objeto entidad de configuración&lt;/b&gt; · la publica un área de la cooperativa; July solo la lee" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="3128.4" y="302" width="336" height="42" as="geometry" /></mxCell>
        <mxCell id="f2-ley-lineas" value="——&amp;gt; flujo principal · &lt;b&gt;1.2.2: 3&lt;/b&gt; = caso 1.2.2, paso 3 de CU-08&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;- - -&amp;gt; flujo alternativo (A1, A2…)&lt;/font&gt;&lt;br&gt;——— control ↔ entidad, con lo que hace sobre ella&lt;br&gt;Marco punteado: controles propios de un caso de nivel 2. Los objetos fuera de los marcos los comparten varios casos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Conexiones permitidas:&lt;/b&gt; actor ↔ borde · borde ↔ control · control ↔ control · control ↔ entidad." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="3070.4" y="360" width="396" height="145" as="geometry" /></mxCell>
        <mxCell id="f2-traza" value="&lt;b&gt;Trazabilidad con CU-08&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 2.1.1 · Entregar los datos conversando&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Iniciar solicitud&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;2 · 4 · 6&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Pedir dato pendiente → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;3 · 5 · 7&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Registrar y validar dato&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Resumir solicitud&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;9&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Resumir solicitud → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;10&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Confirmar solicitud&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;4a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Pedir dato pendiente → Responder (datos del socio)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;5a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Atender mensaje → Pedir dato pendiente&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;10b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Atender mensaje → Registrar y validar dato (corrección)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 2.1.2 · Validar los datos y mantener la continuidad&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1–2&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Registrar y validar dato (cédula)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;3–4&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Verificar cédula ↔ Sistema core&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Guardar avance&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Guardar avance → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;1a–2a · 1b–2b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Registrar y validar dato (teléfono, monto)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;4c–5c&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Sistema core (error) → Verificar cédula → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;7d–8d&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Temporizador → Marcar abandonada&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;9d–10d&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Enviar plantilla de retoma → Chat → Prospecto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;11d–12d&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Atender mensaje → Retomar conversación&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;13d&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Retomar → Pedir dato pendiente → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 2.2.1 · Calcular las condiciones del crédito&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Validar monto y plazo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;2–3&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Calcular simulación → Generar tabla de amortización&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;4 · 7&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Calcular simulación → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;5–6&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Calcular simulación (costo total)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;8–9&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Comparar escenarios → Calcular simulación&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;10&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Comparar escenarios → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;11–12&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Guardar escenario elegido&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;2a–3a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Validar monto y plazo → Responder (fuera de rango)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;8b–9b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Atender mensaje → Guardar escenario elegido&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 2.2.2 · Consultar productos y condiciones&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1–3&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Listar líneas vigentes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Listar líneas vigentes → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Elegir línea&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;6–9&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Consultar condiciones de la línea&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;10&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Consultar condiciones → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;7a–8a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Consultar condiciones (no vigente) → Listar → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 2.3.1 · Evaluar al prospecto con reglas&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1–3&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Obtener reglas vigentes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;4–5&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Consultar datos del socio ↔ Sistema core&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;6–7&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Precalificar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Explicar resultado → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;5a–6a&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Sistema core (sin registro) → Precalificar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;7b–9b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Precalificar → Derivar a revisión ↔ Bandeja del comité&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#B85450;white-space:nowrap;vertical-align:top&quot;&gt;10b&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#B85450&quot;&gt;Derivar a revisión → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding:5px 4px 1px;border-bottom:1px solid #BBBBBB&quot;&gt;&lt;b&gt;CU 2.3.2 · Recibir orientación sobre el resultado&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;1–2&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Explicar resultado → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;3–4&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Listar documentos → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;5–8&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Consultar horarios → Responder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;color:#15213A;white-space:nowrap;vertical-align:top&quot;&gt;9–10&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#15213A&quot;&gt;Atender mensaje → Reservar cita&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;colo