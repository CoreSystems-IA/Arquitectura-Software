html=1;outlineConnect=0;fillColor=#F2C230;strokeColor=#15213A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1282" y="1210.0" width="36" height="70" as="geometry"/></mxCell><mxCell id="flujo02-c71" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#8A94A8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="flujo02-c43" target="flujo02-c70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flujo02-c72" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#8A94A8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="flujo02-c47" target="flujo02-c70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flujo02-c73" value="&lt;b&gt;Personal de agencia&lt;/b&gt;&lt;br&gt;(actor externo)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#F2C230;strokeColor=#15213A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1282" y="1519.0" width="36" height="70" as="geometry"/></mxCell><mxCell id="flujo02-c74" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#8A94A8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="flujo02-c55" target="flujo02-c73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flujo02-c75" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;• El actor principal solo inicia casos de nivel 1 (etapas de valor).&lt;br&gt;• Cada nivel incluye («include») a los del nivel siguiente.&lt;br&gt;• Los actores externos solo participan en casos de nivel 3, así entre el actor principal y un externo siempre hay 3 niveles.&lt;br&gt;• Colores: azul nivel 1, dorado nivel 2, amarillo claro nivel 3; actores externos en dorado." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2E3;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="1678.0" width="620" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>