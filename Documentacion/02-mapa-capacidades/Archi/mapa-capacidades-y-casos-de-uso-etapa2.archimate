  <folder name="Other" id="id-4e8ee11efb2f4e0b8839199dfe2981a0" type="other">
    <element xsi:type="archimate:Grouping" name="Paquete 1 · Atención inicial" id="id-pkg-p1">
      <documentation>Paquete de casos de uso.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Paquete 2 · Perfilamiento, simulación y precalificación" id="id-pkg-p2">
