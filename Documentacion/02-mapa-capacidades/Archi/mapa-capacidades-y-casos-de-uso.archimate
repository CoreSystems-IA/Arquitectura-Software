  <folder name="Business" id="id-ed8e3efd094b4762b2c7a9e410477ea0" type="business">
    <element xsi:type="archimate:BusinessActor" name="Prospecto" id="id-act-prospecto">
      <documentation>Persona interesada en un crédito, socia o no.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Asesor comercial" id="id-act-asesor">
      <documentation>Atiende los leads asignados y los cierra.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Jefe comercial" id="id-act-jefe">
      <documentation>Define prioridad y enrutamiento; supervisa el embudo.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Personal de agencia" id="id-act-agencia">
      <documentation>Gestiona la agenda y confirma citas.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Administrador del asistente" id="id-act-admin">
      <documentation>Edita guiones, intenciones, preguntas frecuentes y plantillas.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Área de productos y crédito" id="id-act-productos">
      <documentation>Jefe de productos, finanzas y analista de crédito.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Delegado de protección de datos" id="id-act-dpd">
      <documentation>Vigila el consentimiento y atiende los derechos del titular.</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-5ff995a5c8a6477694fb29b82138ff5d" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="July · asistente virtual" id="id-july">
      <documentation>Chatbot de captación de prospectos por WhatsApp Business API y widget web.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="WhatsApp Business API" id="id-sys-whatsapp">
      <documentation>Sistema externo (actor secundario en los casos de uso).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Widget web" id="id-sys-widget">
      <documentation>Sistema externo (actor secundario en los casos de uso).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Sistema core" id="id-sys-core">
      <documentation>Sistema externo (actor secundario en los casos de uso).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="CRM de la cooperativa" id="id-sys-crm">
      <documentation>Sistema externo (actor secundario en los casos de uso).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Servicio de notificaciones" id="id-sys-notif">
      <documentation>Sistema externo (actor secundario en los casos de uso).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationEvent" name="Temporizador: pendiente vencido" id="id-evt-timer">
      <documentation>Evento programado que dispara recordatorios y reactivaciones.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-01 Iniciar conversación" id="id-cu01">
      <documentation>Recibir la primera consulta por cualquier canal y responder como July en menos de 2 minutos.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-02 Aceptar aviso de privacidad" id="id-cu02">
      <documentation>Obtener el consentimiento expreso según la LOPDP antes de pedir datos personales.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-03 Registrar lead" id="id-cu03">
      <documentation>Crear el registro trazable del lead desde el primer contacto. Lo dispara CU-02.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-04 Identificar intención y responder preguntas frecuentes" id="id-cu04">
      <documentation>Saber qué línea de crédito busca la persona o resolver su duda.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-05 Reconocer socio existente" id="id-cu05">
      <documentation>Saber si la persona ya es socia o ya escribió antes. Lo dispara CU-07.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-06 Derivar a asesor humano" id="id-cu06">
      <documentation>Pasar la conversación a una persona cuando July no puede resolverla o el prospecto lo pide.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-07 Capturar datos del prospecto" id="id-cu07">
      <documentation>Reunir, conversando, los datos que necesitan la simulación y la precalificación.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-08 Retomar conversación abandonada" id="id-cu08">
      <documentation>Continuar donde la persona se quedó, sin volver a pedirle lo que ya dio.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-09 Simular crédito" id="id-cu09">
      <documentation>Mostrar cuánto pagaría la persona según la línea, el monto y el plazo.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-10 Comparar escenarios" id="id-cu10">
      <documentation>Recalcular con otro monto u otro plazo para elegir la opción que le conviene.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-11 Precalificar prospecto" id="id-cu11">
      <documentation>Dar una respuesta preliminar y no vinculante sobre la viabilidad del crédito.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-12 Consultar requisitos y agendar cita" id="id-cu12">
      <documentation>Decir qué documentos preparar, cómo hacerse socio y reservar una cita en agencia.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-13 Generar ficha del prospecto" id="id-cu13">
      <documentation>Consolidar todo lo que July sabe del prospecto en una ficha lista para trabajar.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-14 Sincronizar lead con el CRM" id="id-cu14">
      <documentation>Crear o actualizar el lead en el CRM sin intervención manual y sin duplicados.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-15 Asignar lead a asesor" id="id-cu15">
      <documentation>Poner cada lead en manos del asesor correcto y avisarle.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-16 Atender lead asignado" id="id-cu16">
      <documentation>Revisar la ficha y seguir la conversación sin pedir otra vez los datos.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-17 Enviar recordatorios y reactivar leads" id="id-cu17">
      <documentation>Recordar documentos o citas pendientes y reactivar conversaciones abandonadas.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-18 Confirmar cita en agencia" id="id-cu18">
      <documentation>Confirmar y recordar las citas reservadas por July.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-19 Actualizar estado y cerrar lead" id="id-cu19">
      <documentation>Mover el lead por sus estados hasta el desembolso o la pérdida y registrar el motivo.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-20 Configurar guiones, intenciones y plantillas" id="id-cu20">
      <documentation>Cambiar lo que July dice y entiende sin programar.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-21 Gestionar líneas, tasas y requisitos" id="id-cu21">
      <documentation>Mantener el catálogo que usan el simulador y la orientación.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-22 Configurar reglas de precalificación" id="id-cu22">
      <documentation>Ajustar la tabla de decisión aprobada por el comité de crédito.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-23 Configurar priorización y enrutamiento" id="id-cu23">
      <documentation>Definir qué es un lead caliente, tibio o frío y cómo se reparten.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-24 Consultar trazabilidad y embudo" id="id-cu24">
      <documentation>Reconstruir el recorrido de cada lead y medir el embudo.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="CU-25 Atender derechos sobre datos personales" id="id-cu25">
      <documentation>Acceso, rectificación, eliminación y retiro del consentimiento según la LOPDP.</documentation>
    </element>
  </folder>
