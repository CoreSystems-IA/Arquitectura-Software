ent="1"><mxGeometry x="1904" y="204" width="26" height="46" as="geometry"/></mxCell><object id="f3-25" label="&lt;b&gt;Jefe comercial&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;:Colaborador&lt;/font&gt;" tipo="lifeline" nombre="Jefe comercial" clase="Colaborador" rol="actor"><mxCell style="text;html=1;align=center;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="1835" y="254" width="165" height="40" as="geometry"/></mxCell></object><mxCell id="f3-26" value="" style="shape=umlActor;verticalLabelPosition=bottom;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#15213A;html=1;" vertex="1" parent="1"><mxGeometry x="2079" y="204" width="26" height="46" as="geometry"/></mxCell><object id="f3-27" label="&lt;b&gt;Personal de agencia&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;:Colaborador&lt;/font&gt;" tipo="lifeline" nombre="Personal de agencia" clase="Colaborador" rol="actor"><mxCell style="text;html=1;align=center;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="2010" y="254" width="165" height="40" as="geometry"/></mxCell></object><mxCell id="f3-28" value="" style="shape=umlActor;verticalLabelPosition=bottom;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#15213A;html=1;" vertex="1" parent="1"><mxGeometry x="2254" y="204" width="26" height="46" as="geometry"/></mxCell><object id="f3-29" label="&lt;b&gt;Asesor comercial&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;:AsesorComercial&lt;/font&gt;" tipo="lifeline" nombre="Asesor comercial" clase="AsesorComercial" rol="actor"><mxCell style="text;html=1;align=center;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="2185" y="254" width="165" height="40" as="geometry"/></mxCell></object><mxCell id="f3-47" value="CU 3.1 · Recibir la oportunidad precalificada (etapa Entrega de oportunidades) · incluye CU 3.1.1 Generar la ficha del prospecto y CU 3.1.2 Registrar el lead en el CRM" style="shape=umlFrame;whiteSpace=wrap;html=1;width=1995;height=30;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#9A9A9A;dashed=1;dashPattern=8 4;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="50" y="320" width="2295" height="870" as="geometry"/></mxCell><mxCell id="f3-112" value="CU 3.2 · Dar seguimiento al lead hasta su cierre (etapa Asignación y seguimiento) · incluye CU 3.2.1 Recibir el lead asignado y CU 3.2.2 Hacer seguimiento y cerrar el lead" style="shape=umlFrame;whiteSpace=wrap;html=1;width=1995;height=30;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#9A9A9A;dashed=1;dashPattern=8 4;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="50" y="1220" width="2295" height="2544" as="geometry"/></mxCell><mxCell id="f3-140" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;——▶ &lt;b&gt;llamada&lt;/b&gt;: «N: método(parámetros)», un método de la clase de la línea de vida que la recibe (CLS-02); N es el paso del flujo en CU-08&lt;br&gt;- - -&amp;gt; &lt;b&gt;retorno&lt;/b&gt;: el receptor devuelve el resultado de la llamada anterior; no es un método&lt;br&gt;Marco gris: caso de nivel 1 con los casos de nivel 2 que incluye · marco rojo &lt;b&gt;alt&lt;/b&gt; / &lt;b&gt;opt&lt;/b&gt;: flujo alternativo de CU-08, con los pasos que reemplaza&lt;br&gt;Cabeceras: actor (persona) · borde (canal o sistema externo) · control (:July) · entidad (azul: negocio; lila: configuración)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BBBBBB;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="3834" width="1500" height="90" as="geometry"/></mxCell><object id="f3-30" label="1: consultarPublicacion(tipo)" tipo="llamada" paso="1" desde="July" hacia="Jefe comercial" cu3="3.1.1.2"><mxCell style="html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#15213A;fontColor=#15213A;verticalAlign=bottom;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="517" y="368" as="sourcePoint"/><mxPoint x="1917" y="368" as="targetPoint"/></mxGeometry></mxCell></object><object id="f3-31" label="2: criterios de lead caliente, tibio y frío" tipo="retorno" paso="2" desde="Jefe comercial" hacia="July" cu3="3.1.1.2"><mxCell style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#555555;fontColor=#555555;verticalAlign=bottom;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1917" y="402" as="sourcePoint"/><mxPoint x="517" y="402" as="targetPoint"/></mxGeometry></mxCell></object><object id="f3-32" label="3: priorizar(criterios)" tipo="llamada" paso="3" desde="July" hacia="Lead" cu3="3.1.1.2"><mxCell style="html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#15213A;fontColor=#15213A;verticalAlign=bottom;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="517" y="436" as="sourcePoint"/><mxPoint x="1042" y="436" as="targetPoint"/></mxGeometry></mxCell></object><object id="f3-33" label="4: prioridad del lead" tipo="retorno" paso="4" desde="Lead" hacia="July" cu3="3.1.1.2"><mxCell style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#555555;fontColor=#555555;verticalAlign=bottom;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1042" y="470" as="sourcePoint"/><mxPoint x="517" y="470" as="targetPoint"/></mxGeometry></mxCell></object><object id="f3-34" label="5: generarFicha()" tipo="llamada" paso="5" desde="July" hacia="Lead" cu3="3.1.1.1"><mxCell style="html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#15213A;fontColor=#15213A;verticalAlign=bottom;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="517" y="504" as="sourcePoint"/><mxP