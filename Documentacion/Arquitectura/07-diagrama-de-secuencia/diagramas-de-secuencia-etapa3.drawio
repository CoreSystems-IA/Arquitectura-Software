"1"><mxGeometry x="122" y="3468" width="2195" height="22" as="geometry"/></mxCell><mxCell id="f3-1" value="&lt;b&gt;Diagrama de secuencia · Flujo de valor 3 · Entrega, seguimiento y conversión&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="36" as="geometry"/></mxCell><mxCell id="f3-2" value="SEC-01 v2 · Etapa 3 · Deriva de CU-08 v2.0 (un mensaje por paso, con su número) y CLS-02 (cada llamada es un método de la clase que la recibe, con sus mismos parámetros)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1600" height="22" as="geometry"/></mxCell><mxCell id="f3-3" value="&lt;b&gt;Actor principal:&lt;/b&gt; Asesor comercial&lt;br&gt;&lt;b&gt;Actores secundarios:&lt;/b&gt; Jefe comercial, CRM de la cooperativa, Prospecto, WhatsApp Business API, Personal de agencia, Comité de crédito&lt;br&gt;&lt;b&gt;Disparador:&lt;/b&gt; El lead termina la precalificación como APTO o A_REVISAR (flujo 2, paso 69 o alternativo A11). July inicia el flujo; el Asesor comercial es su beneficiario.&lt;br&gt;&lt;b&gt;Casos de nivel 1:&lt;/b&gt; CU 3.1 Recibir la oportunidad precalificada, CU 3.2 Dar seguimiento al lead hasta su cierre" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="2315" height="90" as="geometry"/></mxCell><mxCell id="f3-4" value="" style="shape=umlActor;verticalLabelPosition=bottom;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#15213A;html=1;" vertex="1" parent="1"><mxGeometry x="154" y="204" width="26" height="46" as="geometry"/></mxCell><object id="f3-5" label="&lt;b&gt;Prospecto&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;:Prospecto&lt;/font&gt;" tipo="lifeline" nombre="Prospecto" clase="P