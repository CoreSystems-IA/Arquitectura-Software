vertex="1" parent="1"><mxGeometry x="1595" y="526" width="50" height="56" as="geometry"/></mxCell></object><object id="r1-32" label="&lt;b&gt;Buscar pregunta frecuente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;PlantillaMensaje.buscarRespuesta()&lt;/font&gt;" tipo="control" nombre="July"><mxCell style="ellipse;shape=umlControl;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1595" y="674" width="50" height="56" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="rob-f2" name="Flujo 2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1958" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r2-1" value="&lt;b&gt;Diagrama de robustez · Flujo de valor 2 · Captura, simulación y precalificación&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="36" as="geometry"/></mxCell><mxCell id="r2-2" value="ROB-01 v2 · Etapa 3 · Deriva de SEC-01 v2 (los objetos son sus líneas de vida) y CLS-02 (cada control lleva el método que invoca July). Cada conexión lleva los pasos del flujo en CU-08." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1800" height="22" as="geometry"/></mxCell><mxCell id="r2-3" value="&lt;b&gt;Leyenda&lt;/b&gt; · actor (persona) · borde (canal, sistema externo o panel de la cooperativa) · control (acción de July; debajo, el método de CLS-02 que invoca) · entidad (azul: negocio; lila: configuración)&lt;br&gt;Conexiones permitidas: actor ↔ borde · borde ↔ control · control ↔ control · control ↔ entidad. Etiqueta: pasos del flujo en CU-08 (los alternativos llevan letra). El control «Atender mensaje» (July.atender) recibe todo lo que llega a July y coordina a los demás controles (líneas grises sin pasos). El «Panel de la cooperativa» es la vista por la que los colaboradores y el asesor reciben los avisos (Colaborador.recibir) y escriben a July (July.atender); no es una clase de CLS-02." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BBBBBB;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="2120" height="80" as="geometry"/></mxCell><object id="r2-108" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r2-4" target="r2-46"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r2-107" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r2-4" target="r2-45"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r2-106" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r2-4" target="r2-44"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r2-105" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r2-4" target="r2-42"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r2-104" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r2-4" target="r2-40"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r2-103" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r2-4" target="r2-39"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r2-102" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edg