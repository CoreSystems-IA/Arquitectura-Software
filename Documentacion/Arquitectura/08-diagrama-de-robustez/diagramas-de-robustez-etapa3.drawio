<mxfile host="app.diagrams.net" agent="ROB-01 v2"><diagram id="rob-f1" name="Flujo 1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1461" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r1-1" value="&lt;b&gt;Diagrama de robustez · Flujo de valor 1 · Atracción y primer contacto&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="36" as="geometry"/></mxCell><mxCell id="r1-2" value="ROB-01 v2 · Etapa 3 · Deriva de SEC-01 v2 (los objetos son sus líneas de vida) y CLS-02 (cada control lleva el método que invoca July). Cada conexión lleva los pasos del flujo en CU-08." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1800" height="22" as="geometry"/></mxCell><mxCell id="r1-3" value="&lt;b&gt;Leyenda&lt;/b&gt; · actor (persona) · borde (canal, sistema externo o panel de la cooperativa) · control (acción de July; debajo, el método de CLS-02 que invoca) · entidad (azul: negocio; lila: configuración)&lt;br&gt;Conexiones permitidas: actor ↔ borde · borde ↔ control · control ↔ control · control ↔ entidad. Etiqueta: pasos del flujo en CU-08 (los alternativos llevan letra). El control «Atender mensaje» (July.atender) recibe todo lo que llega a July y coordina a los demás controles (líneas grises sin pasos). El «Panel de la cooperativa» es la vista por la que los colaboradores y el asesor reciben los avisos (Colaborador.recibir) y escriben a July (July.atender); no es una clase de CLS-02." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BBBBBB;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="2120" height="80" as="geometry"/></mxCell><object id="r1-74" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r1-6" target="r1-32"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r1-73" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r1-6" target="r1-31"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r1-72" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r1-6" target="r1-28"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r1-71" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r1-6" target="r1-26"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r1-70" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r1-6" target="r1-24"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r1-69" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r1-6" target="r1-22"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r1-68" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r1-6" target="r1-21"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r1-67" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r1-6" target="r1-19"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r1-66" label="" tipo="conexion" pasos=""><mxCell style="html=1;endArrow=none;strokeColor=#C8C8C8;" edge="1" parent="1" source="r1-6" target="r1-17"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="r1-65" label="" tipo="conexion" pasos=""><mxCell sty