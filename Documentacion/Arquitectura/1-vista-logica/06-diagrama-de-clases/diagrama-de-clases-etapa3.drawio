ap;html=1;fontSize=11;fontSize=10;" vertex="1" parent="enum-ResultadoPrecalificacion"><mxGeometry y="40" width="242" height="58" as="geometry"/></mxCell><mxCell id="enum-EstadoCita" value="«enumeration»&lt;br&gt;&lt;b&gt;EstadoCita&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;swimlaneFillColor=#FFFFFF;rounded=0;" vertex="1" parent="1"><mxGeometry x="2716" y="1630" width="180" height="114" as="geometry"/></mxCell><mxCell id="enum-EstadoCita-v" value="RESERVADA&lt;br&gt;CONFIRMADA&lt;br&gt;REPROGRAMADA&lt;br&gt;ATENDIDA" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontSize=10;" vertex="1" parent="enum-EstadoCita"><mxGeometry y="40" width="180" height="74" as="geometry"/></mxCell><mxCell id="enum-TipoPlantilla" value="«enumeration»&lt;br&gt;&lt;b&gt;TipoPlantilla&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;swimlaneFillColor=#FFFFFF;rounded=0;" vertex="1" parent="1"><mxGeometry x="2916" y="1630" width="180" height="178" as="geometry"/></mxCell><mxCell id="enum-TipoPlantilla-v" value="BIENVENIDA&lt;br&gt;AVISO_PRIVACIDAD&lt;br&gt;MENU&lt;br&gt;MENU_BASICO&lt;br&gt;PREGUNTA_FRECUENTE&lt;br&gt;RETOMA&lt;br&gt;RECORDATORIO&lt;br&gt;REACTIVACION" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontSize=10;" vertex="1" parent="enum-TipoPlantilla"><mxGeometry y="40" width="180" height="138" as="geometry"/></mxCell><mxCell id="enum-TipoRegla" value="«enumeration»&lt;br&gt;&lt;b&gt;TipoRegla&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;swimlaneFillColor=#FFFFFF;rounded=0;" vertex="1" parent="1"><mxGeometry x="3116" y="1630" width="180" height="98" as="geometry"/></mxCell><mxCell id="enum-TipoRegla-v" value="PRECALIFICACION&lt;br&gt;PRIORIDAD&lt;br&gt;ENRUTAMIENTO" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontSize=10;" vertex="1" parent="enum-TipoRegla"><mxGeometry y="40" width="180" height="58" as="geometry"/></mxCell><mxCell id="nota-control" value="&lt;b&gt;July es el único control&lt;/b&gt;&lt;br&gt;Los 51 controles de ROB-01 son acciones de July: cada uno delega en el método anotado con ◂ en la clase borde o entidad que lo implementa. July solo guarda sus parámetros de operación.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cómo leer las capas&lt;/b&gt;&lt;br&gt;El actor escribe por un &lt;b&gt;borde&lt;/b&gt;, el borde avisa al &lt;b&gt;control&lt;/b&gt; con July.atender() y el control llama a las &lt;b&gt;entidades&lt;/b&gt;. Ningún borde llama a una entidad salvo las dos dependencias «usa» 19 y 20, que son los datos que el core y el CRM completan." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CCCCCC;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="660" y="460" width="410" height="300" as="geometry"/></mxCell><mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Capas: ■ «interfaz» borde · ■ «control» · ■ «entidad» actor · ■ «entidad» negocio · ■ «entidad» configuración · ■ «enumeration»&lt;br&gt;Relaciones: ◆—▸ composición · —▷ generalización (cursiva = clase abstracta) · —▸ asociación con multiplicidad origen — destino · - -▸ dependencia «usa» (parámetro) o «llama» (paso de CU-08). El número gris es el de la relación en CLS-01.&lt;br&gt;Miembros: - atributo · + método · subrayado = «estático» · /atributo = derivado · [0..1] = opcional · cada clase muestra solo lo propio y hereda lo de su superclase.&lt;br&gt;◂ control de ROB-01 que invoca el método; en gris, el método que no tiene control porque el actor llama al borde directamente." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CCCCCC;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="1870" width="4230" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>