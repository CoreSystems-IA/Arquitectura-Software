<mxfile host="app.diagrams.net" agent="DAT-03 v1.0"><diagram name="Modelo de datos July" id="modelo-datos-july"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3560" pageHeight="2510" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="&lt;b&gt;Modelo de datos — July (Cooperativa Padre Julián Lorente)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#15213A;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2000" height="40" as="geometry"/></mxCell><mxCell id="subtitulo" value="DAT-03 v1.0 · Diagrama entidad-relación físico de DAT-02 (PostgreSQL 16, esquema &lt;i&gt;july&lt;/i&gt;), descrito en DAT-01. 26 tablas, 39 claves foráneas (35 dibujadas; las 4 &lt;i&gt;publicado_por&lt;/i&gt; hacia &lt;i&gt;colaborador&lt;/i&gt; se indican en su fila), 17 tipos enumerados. Cada tabla lleva el color de su dominio de datos de LIN-01." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="2400" height="40" as="geometry"/></mxCell><mxCell id="banda-op" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;dashed=1;dashPattern=8 8;opacity=25;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="2480" height="950" as="geometry"/></mxCell><mxCell id="banda-op-tit" value="&lt;b&gt;OPERACIÓN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#777777;&quot;&gt;lo que July registra en cada conversación: identidad, interacción, oportunidad, solicitud y agenda (DD-1 a DD-5)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#15213A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="204" width="2480" height="44" as="geometry"/></mxCell><mxCell id="banda-conf" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF