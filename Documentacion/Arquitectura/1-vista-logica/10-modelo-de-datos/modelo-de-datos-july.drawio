endArrow=ERmandOne;endFill=0;endSize=12;exitX=0.0;exitY=0.3475;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.8878;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="t-linea_requisito" target="t-linea_credito_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk7-lbl" value="id_linea_version" style="text;html=1;verticalAlign=middle;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;fontStyle=2;spacing=0;align=left;" vertex="1" parent="1"><mxGeometry x="2500" y="1583" width="100" height="16" as="geometry"/></mxCell><mxCell id="fk9" value="" style="edgeStyle=none;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#4D4D4D;strokeWidth=2;startArrow=ERzeroToMany;startFill=0;startSize=12;endArrow=ERmandOne;endFill=0;endSize=12;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="t-plantilla_opcion" target="t-plantilla_mensaje"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk9-lbl" value="id_plantilla" style="text;html=1;verticalAlign=middle;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;fontStyle=2;spacing=0;align=left;" vertex="1" parent="1"><mxGeometry x="246" y="1590" width="77" height="16" as="geometry"/></mxCell><mxCell id="fk11" value="" style="edgeStyle=none;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#4D4D4D;strokeWidth=2;startArrow=ERzeroToMany;startFill=0;startSize=12;endArrow=ERmandOne;endFill=0;endSize=12;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="t-regla_parametro" target="t-regla_negocio"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk11-lbl" value="id_regla" style="text;html=1;verticalAlign=middle;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;fontStyle=2;spacing=0;align=left;" vertex="1" parent="1"><mxGeometry x="1806" y="1548" width="54" height="16" as="geometry"/></mxCell><mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; clave primaria · &lt;b&gt;FK&lt;/b&gt; clave foránea · &lt;b&gt;UK&lt;/b&gt; única&lt;br&gt;&lt;u&gt;subrayado&lt;/u&gt;: parte de la clave primaria&lt;br&gt;&lt;b&gt;negrita&lt;/b&gt;: NOT NULL · normal: admite nulos&lt;br&gt;&lt;i&gt;gris en cursiva&lt;/i&gt;: tipo de PostgreSQL o enumerado&lt;br&gt;&lt;br&gt;&lt;b&gt;Cardinalidad&lt;/b&gt; (pata de gallo, en el extremo de cada tabla):&lt;br&gt;&lt;b&gt;||&lt;/b&gt; uno y solo uno · &lt;b&gt;o|&lt;/b&gt; cero o uno · &lt;b&gt;o&amp;lt;&lt;/b&gt; cero o muchos&lt;br&gt;Línea gruesa: composición (ON DELETE CASCADE)&lt;br&gt;Línea fina: asociación o dependencia guardada&lt;br&gt;El arco marca un cruce sin conexión.&lt;br&gt;&lt;br&gt;&lt;b&gt;Dominios de datos (LIN-01)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CCCCCC;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2620" y="320" width="400" height="480" as="geometry"/></mxCell><mxCell id="dom-DD-1" value="DD-1 · Interacción" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2634" y="548" width="372" height="24" as="geometry"/></mxCell><mxCell id="dom-DD-2" value="DD-2 · Identidad y consentimiento" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2634" y="578" width="372" height="24" as="geometry"/></mxCell><mxCell id="dom-DD-3" value="DD-3 · Oportunidad comercial" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2634" y="608" width="372" height="24" as="geometry"/></mxCell><mxCell id="dom-DD-4" value="DD-4 · Solicitud y evaluación" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2634" y="638" width="372" height="24" as="geometry"/></mxCell><mxCell id="dom-DD-5" value="DD-5 · Agenda" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2634" y="668" width="372" height="24" as="geometry"/></mxCell><mxCell id="dom-DD-6" value="DD-6 · Configuración" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2634" y="698" width="372" height="24" as="geometry"/></mxCell><mxCell id="dom-DD-7" value="DD-7 · Personas de la cooperativa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2634" y="728" width="372" height="24" as="geometry"/></mxCell><mxCell id="dom-BIT" value="Bitácora de linaje (B-03, B-04)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D0CEE2;strokeColor=#56517E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2634" y="758" width="372" height="24" as="geometry"/></mxCell><mxCell id="notas" value="&lt;b&gt;Lo que no se ve como tabla&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Vistas:&lt;/b&gt; &lt;i&gt;v_asesor_carga&lt;/i&gt; (carga del asesor), &lt;i&gt;v_linea_vigente&lt;/i&gt;, &lt;i&gt;v_regla_vigente&lt;/i&gt;, &lt;i&gt;v_ficha_lead&lt;/i&gt; (ficha sin datos cifrados, con faltantes, PC-14).&lt;br&gt;&lt;b&gt;Triggers:&lt;/b&gt; &lt;i&gt;evento&lt;/i&gt; encadenado con SHA-256, sin UPDATE, DELETE ni TRUNCATE (3); versiones publicadas de línea, plantilla y regla inmutables salvo &lt;i&gt;vigente&lt;/i&gt; (3).&lt;br&gt;&lt;b&gt;Una sola versión vigente:&lt;/b&gt; índices únicos parciales &lt;i&gt;ux_linea_vigente&lt;/i&gt;, &lt;i&gt;ux_plantilla_vigente&lt;/i&gt;, &lt;i&gt;ux_regla_vigente&lt;/i&gt;.&lt;br&gt;&lt;b&gt;Discriminadores constantes:&lt;/b&gt; &lt;i&gt;tipo_aviso&lt;/i&gt;, &lt;i&gt;tipo_regla_*&lt;/i&gt; y &lt;i&gt;asesor_comercial.rol&lt;/i&gt; entran en la FK compuesta para garantizar el tipo de la fila referida.&lt;br&gt;&lt;b&gt;Cifrado:&lt;/b&gt; nombres, cédula, teléfono y correo llegan cifrados (AES-256, llaves en KMS); el índice HMAC permite buscar.&lt;br&gt;&lt;b&gt;Detalle:&lt;/b&gt; restricciones CHECK, índices y comentarios en DAT-02; diccionario por tabla en DAT-01." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CCCCCC;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3120" y="320" width="360" height="600" as="geometry"/></mxCell><mxCell id="enum-tit" value="&lt;b&gt;TIPOS ENUMERADOS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#777777;&quot;&gt;13 de CLS-01 con los mismos valores y 4 nuevos de LIN-01&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#15213A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="2024" width="1200" height="44" as="geometry"/></mxCell><mxCell id="enum-tipo_canal" value="&lt;b&gt;«enum» tipo_canal&lt;/b&gt;" style="swimlane;fontStyle=0;startSize=26;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#999999;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="2080" width="360" height="104" as="geometry"/></mxCell><mxCell id="enum-tipo_canal-v" value="WHATSAPP, WEB" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;spacingLeft=8;spacingRight=8;" vertex="1" parent="enum-tipo_canal"><mxGeometry y="26" width="360" height="78" as="geometry"/></mxCell><mxCell id="enum-emisor" value="&lt;b&gt;«enum» emisor&lt;/b&gt;" style="swimlane;fontStyle=0;startSize=26;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#999999;swimlaneFillColor=#FFFFFF;collapsible=0;" 